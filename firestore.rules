rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App personal de un solo usuario: solo la cuenta de Roberto puede leer/escribir.
    // Autoriza por email (regla probada en vivo: bloquea a anonimos y a otros correos).
    // NOTA: se intento fijar por UID (commit f01f8da) pero el UID copiado a mano no
    // coincidia con la sesion y bloqueaba al propio dueno; se revirtio a email, que es
    // seguro y estable. Si algun dia se re-intenta el UID, leerlo desde la app (no
    // copiarlo del panel) para no equivocar el caracter.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'rl7103405@gmail.com';
    }
  }
}
