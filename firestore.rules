rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App personal de un solo usuario: solo la cuenta de Roberto puede leer/escribir.
    // Fijada por UID inmutable (mas robusto que por email: el UID es unico, no reusable
    // y no depende de que el correo este verificado ni de que nunca cambie).
    // Cubre todo: cartera/*, gastos, ingresos, transferencias, stocksOps y futuras.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == 'bafQTqrYdmhSYpPaRx3GfYyfuCj2';
    }
  }
}
