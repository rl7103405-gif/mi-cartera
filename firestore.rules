rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DOS usuarios en el mismo proyecto Firebase, cada quien lleva su propia cartera:
    // Roberto (rl7103405@gmail.com) y Zoe (zoe.frei@outlook.de). Ambas cuentas
    // autorizadas. Regla probada en vivo: bloquea a anonimos y a cualquier otro correo.
    // NOTA: hoy ambos correos pueden leer/escribir cualquier doc (no hay aislamiento por
    // usuario a nivel reglas). Si se quiere que ninguno vea los datos del otro, hay que
    // namespacar los documentos por UID y separarlos por regla — pendiente por mapear.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['rl7103405@gmail.com', 'zoe.frei@outlook.de'];
    }
  }
}
